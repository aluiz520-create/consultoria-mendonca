# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL da aplicacao (usada em redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Asaas (cobranca recorrente) — comece pelo sandbox antes de ir para producao
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token que voce define ao cadastrar o webhook no Asaas (Configuracoes > Integracoes > Webhooks)
ASAAS_WEBHOOK_TOKEN=
